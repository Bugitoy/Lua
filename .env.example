EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required for Google Maps on Android (Maps SDK for Android enabled in Google Cloud).
# Restrict key to package: com.anonymous.Lua and your debug/release SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# The invite site deployed from web/ (host only, no https://), e.g. lua-friends.vercel.app.
# Friend codes are shared as https://<host>/friend/LUA-XXXXXX links. Changing it needs a native rebuild.
EXPO_PUBLIC_INVITE_HOST=
